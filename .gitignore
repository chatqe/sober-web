# Node.js  忽略项目的依赖文件夹
node_modules/
npm-debug.log
yarn-error.log
package-lock.json
yarn.lock

# IDEs and Editors  忽略编辑器相关的配置文件夹
.idea/
.vscode/
.qoder/
*.sublime-workspace
*.sublime-project

# Operating System files  忽略Mac OS系统生成的.DS_Store文件。
.DS_Store
Thumbs.db

# Build directories  忽略构建输出目录
/dist/
/build/
/out/

# Logs  忽略日志文件
*.log
*.log.*

# Environment files  忽略本地环境变量文件，这些文件通常用于存储开发、测试和生产环境的配置
.env
.env.local
.env.development
.env.test
.env.production

# Temporary files
*.swp
*.swo
*.bak
*.tmp

# Coverage reports  忽略代码覆盖率报告
/coverage/

# Browser Sync
/browser-sync/

# TypeScript
*.tsbuildinfo

# Orval 生成物不入库：先启动后端，再执行 pnpm orval 本地生成
/src/api/generated/
/src/types/modules/

# Webpack
.cache/

# Next.js
.next/
out/

# Nuxt.js
.nuxt/

# Vue.js
# *.vue.js

# Angular
# .angular/

# Other common build tools
/.cache/
*.tgz

# Optional: add your own specific file extensions or folders to ignore

# AI / IDE 临时文件
.claude/
.workbuddy/
CLAUDE.md
memory/

# 项目审计临时文件
project-audit.html
project-audit.md

# unplugin-vue-components 自动生成
auto-imports.d.ts
components.d.ts

# Shell 错误 dump
*.stackdump

# pnpm 锁文件已在版本控制中，此处不忽略
# pnpm-lock.yaml

# Vite 预构建缓存目录
node_modules/.vite/

# E2E / 调试截图
/*.png
/.playwright-mcp/
/logs/
/src/components/structure.txt

# AI 文档备份
/CLAUDE.md.bak-*
/CLAUDE.md.before-*

# Shell 重定向事故产物（文件名含全角冒号，用通配符避开非 ASCII 字符）
/C*UsersUpjqs*.txt
/E*webqs-web*.cjs

# 一次性调试脚本
/scripts/test_*.cjs
